
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can access only their own data.
    match /users/{userId} {
      allow read, write:
        if request.auth != null
        && request.auth.uid == userId;

      // Secure documents inside the user's subcollections.
      match /{document=**} {
        allow read, write:
          if request.auth != null
          && request.auth.uid == userId;
      }
    }
  }
}
