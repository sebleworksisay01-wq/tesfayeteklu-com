rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Default deny catch-all
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Pinned Verified Administrator Authorization Helper
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'contactesfaye@gmail.com';
    }

    // Valid Image MIME Type validation
    function isValidImageType() {
      return request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif|svg\\+xml)');
    }

    // Valid Document MIME Type validation
    function isValidDocType() {
      return request.resource.contentType.matches('application/pdf');
    }

    // Maximum file size limit: 10 MB (10 * 1024 * 1024 bytes)
    function isUnderMaxSize() {
      return request.resource.size <= 10 * 1024 * 1024;
    }

    // 1. Public Portfolio Projects Screenshots & Covers
    match /projects/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidImageType() && isUnderMaxSize();
      allow delete: if isAdmin();
    }

    // 2. Public Site Branding, Logos & Favicons
    match /branding/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidImageType() && isUnderMaxSize();
      allow delete: if isAdmin();
    }

    // 3. Protected Project Documentation & Spec PDFs
    match /documents/{fileName} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && isValidDocType() && isUnderMaxSize();
      allow delete: if isAdmin();
    }
  }
}
