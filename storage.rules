rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Default deny catch-all safety net
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Pinned Verified Administrator Authorization Helper
    // Requires authenticated token with email_verified == true, pinned email, and trusted server custom claim admin == true
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'contactesfaye@gmail.com'
        && request.auth.token.admin == true;
    }

    // Valid Image MIME Type validation
    function isValidImageType() {
      return request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif|svg\\+xml)');
    }

    // Valid Document MIME Type validation
    function isValidDocType() {
      return request.resource.contentType.matches('application/pdf');
    }

    // Maximum file size limit: 10 MB (10 * 1024 * 1024 bytes)
    function isUnderMaxSize() {
      return request.resource.size <= 10 * 1024 * 1024;
    }

    // 1. Public Portfolio Projects Screenshots, Covers & Visual Assets
    // Public visitors can only view published screenshots and visual demos.
    // Uploads, updates, and deletions strictly require verified admin with custom claim.
    match /projects/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidImageType() && isUnderMaxSize();
      allow delete: if isAdmin();
    }
    match /projects/{folder}/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidImageType() && isUnderMaxSize();
      allow delete: if isAdmin();
    }

    // 2. Public Site Branding, Logos, Icons & Favicons
    // Public visitors can read branding assets.
    // Uploads, updates, and deletions strictly require verified admin with custom claim.
    match /branding/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidImageType() && isUnderMaxSize();
      allow delete: if isAdmin();
    }
    match /branding/{folder}/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidImageType() && isUnderMaxSize();
      allow delete: if isAdmin();
    }

    // 3. Protected Project Documentation & Spec PDFs
    // Strictly confidential: Only the verified administrator with custom claim can read, upload, or delete.
    match /documents/{fileName} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && isValidDocType() && isUnderMaxSize();
      allow delete: if isAdmin();
    }
    match /documents/{folder}/{fileName} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && isValidDocType() && isUnderMaxSize();
      allow delete: if isAdmin();
    }
  }
}
