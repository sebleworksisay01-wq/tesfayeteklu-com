{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile document accessible strictly by the owning user and administrator.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 100 },
        "fullName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "enum": ["Administrator", "User"] },
        "emailVerified": { "type": "boolean" },
        "accountStatus": { "type": "string", "enum": ["active", "suspended"] },
        "avatarUrl": { "type": "string", "maxLength": 512 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "lastLoginAt": { "type": "string" }
      }
    },
    "Project": {
      "title": "Project",
      "description": "Portfolio demonstration project or client solution record.",
      "type": "object",
      "properties": {
        "slug": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "title": { "type": "string", "maxLength": 200 },
        "shortDescription": { "type": "string", "maxLength": 500 },
        "description": { "type": "string", "maxLength": 500 },
        "solutionType": { "type": "string", "enum": ["Website Design", "Mobile Application Development", "Web Application Development"] },
        "category": { "type": "string", "maxLength": 100 },
        "subCategory": { "type": "string", "maxLength": 150 },
        "published": { "type": "boolean" },
        "featured": { "type": "boolean" },
        "thumbnail": { "type": "string", "maxLength": 1024 },
        "imageUrl": { "type": "string", "maxLength": 1024 },
        "imagePath": { "type": "string", "maxLength": 512 },
        "sortOrder": { "type": "number" },
        "demoUrl": { "type": "string", "maxLength": 1024 }
      },
      "required": ["slug", "solutionType", "published"]
    },
    "Service": {
      "title": "Service",
      "description": "Enterprise software engineering or digital consultancy service offering.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "slug": { "type": "string", "maxLength": 128 },
        "iconName": { "type": "string", "maxLength": 64 },
        "shortDescription": { "type": "string", "maxLength": 500 },
        "fullDescription": { "type": "string", "maxLength": 5000 },
        "serviceImage": { "type": "string", "maxLength": 1024 },
        "serviceCategory": { "type": "string", "maxLength": 100 },
        "order": { "type": "number" },
        "published": { "type": "boolean" },
        "seoTitle": { "type": "string", "maxLength": 200 },
        "seoDescription": { "type": "string", "maxLength": 500 }
      },
      "required": ["title", "slug", "published"]
    },
    "BlogPost": {
      "title": "BlogPost",
      "description": "Engineering blog post or technical news article.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 256 },
        "slug": { "type": "string", "maxLength": 128 },
        "excerpt": { "type": "string", "maxLength": 500 },
        "content": { "type": "string" },
        "author": { "type": "string", "maxLength": 128 },
        "category": { "type": "string", "maxLength": 100 },
        "coverImage": { "type": "string", "maxLength": 1024 },
        "published": { "type": "boolean" },
        "featured": { "type": "boolean" },
        "publishedDate": { "type": "string" }
      },
      "required": ["title", "slug", "published"]
    },
    "Testimonial": {
      "title": "Testimonial",
      "description": "Client review or case outcome benchmark.",
      "type": "object",
      "properties": {
        "author": { "type": "string", "maxLength": 128 },
        "company": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "maxLength": 100 },
        "quote": { "type": "string", "maxLength": 2000 },
        "avatarUrl": { "type": "string", "maxLength": 1024 },
        "rating": { "type": "number" },
        "metric": { "type": "string", "maxLength": 100 },
        "featured": { "type": "boolean" },
        "published": { "type": "boolean" }
      },
      "required": ["author", "company", "quote", "published"]
    },
    "ClientPartner": {
      "title": "ClientPartner",
      "description": "Enterprise client logo or certified technology partnership record.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 150 },
        "logoUrl": { "type": "string", "maxLength": 1024 },
        "websiteUrl": { "type": "string", "maxLength": 1024 },
        "industry": { "type": "string", "maxLength": 100 },
        "partnershipType": { "type": "string", "enum": ["Client", "Tech Partner", "Certified Vendor"] },
        "featured": { "type": "boolean" },
        "published": { "type": "boolean" }
      },
      "required": ["name", "logoUrl", "published"]
    },
    "TeamMember": {
      "title": "TeamMember",
      "description": "Leadership or engineering team member profile.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "maxLength": 120 },
        "bio": { "type": "string", "maxLength": 1000 },
        "photoUrl": { "type": "string", "maxLength": 1024 },
        "department": { "type": "string", "maxLength": 80 },
        "published": { "type": "boolean" }
      },
      "required": ["name", "role", "published"]
    },
    "MediaItem": {
      "title": "MediaItem",
      "description": "Uploaded image or document asset tracked in the media library.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 200 },
        "fileName": { "type": "string", "maxLength": 200 },
        "fileUrl": { "type": "string", "maxLength": 1024 },
        "fileType": { "type": "string", "maxLength": 100 },
        "fileSize": { "type": "number" },
        "folder": { "type": "string", "maxLength": 64 },
        "uploadedAt": { "type": "string" }
      },
      "required": ["name", "fileUrl"]
    },
    "ContentRevision": {
      "title": "ContentRevision",
      "description": "Historical snapshot of CMS configuration for version rollback.",
      "type": "object",
      "properties": {
        "version": { "type": "number" },
        "timestamp": { "type": "string" },
        "authorEmail": { "type": "string", "maxLength": 150 },
        "summary": { "type": "string", "maxLength": 500 },
        "snapshot": { "type": "object" }
      },
      "required": ["version", "timestamp", "summary"]
    },
    "CustomPage": {
      "title": "CustomPage",
      "description": "Dynamic custom page document.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "slug": { "type": "string", "maxLength": 128 },
        "content": { "type": "string" },
        "published": { "type": "boolean" }
      },
      "required": ["title", "slug", "published"]
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Centralized global configuration, identity, navigation, and theme.",
      "type": "object",
      "properties": {
        "identity": { "type": "object" },
        "navigation": { "type": "object" },
        "theme": { "type": "object" },
        "home": { "type": "object" },
        "aboutUs": { "type": "object" },
        "services": { "type": "array" },
        "clients": { "type": "array" },
        "teamMembers": { "type": "array" },
        "mediaLibrary": { "type": "array" },
        "revisions": { "type": "array" },
        "contactForm": { "type": "object" },
        "seo": { "type": "object" },
        "version": { "type": "number" },
        "lastUpdated": { "type": "string" }
      },
      "required": ["identity", "navigation", "theme"]
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "Prospective client project inquiry or consultation quote request.",
      "type": "object",
      "properties": {
        "fullName": { "type": "string", "maxLength": 120 },
        "companyName": { "type": "string", "maxLength": 150 },
        "email": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 50 },
        "country": { "type": "string", "maxLength": 80 },
        "solutionType": { "type": "string", "maxLength": 100 },
        "industry": { "type": "string", "maxLength": 120 },
        "projectDescription": { "type": "string", "maxLength": 5000 },
        "requiredFeatures": { "type": "string", "maxLength": 2000 },
        "budgetRange": { "type": "string", "maxLength": 80 },
        "expectedCompletionDate": { "type": "string", "maxLength": 80 },
        "preferredContactMethod": { "type": "string", "enum": ["Email", "Phone", "WhatsApp", "Video Call"] },
        "status": { "type": "string", "enum": ["New", "Contacted", "In Progress", "Quoted", "Won", "Closed"] }
      },
      "required": ["fullName", "email", "projectDescription"]
    },
    "AdminData": {
      "title": "AdminData",
      "description": "Protected administrator dashboard metadata and counters.",
      "type": "object",
      "properties": {
        "lastActive": { "type": "string" },
        "notes": { "type": "string", "maxLength": 2000 }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document accessible strictly by the owning user and administrator."
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Portfolio projects and showcase applications."
    },
    "/services/{serviceId}": {
      "schema": "Service",
      "description": "Managed services offerings."
    },
    "/blogPosts/{postId}": {
      "schema": "BlogPost",
      "description": "Engineering articles and company news."
    },
    "/testimonials/{testimonialId}": {
      "schema": "Testimonial",
      "description": "Client reviews and case impact testimonials."
    },
    "/clients/{clientId}": {
      "schema": "ClientPartner",
      "description": "Enterprise clients and certified technology partners."
    },
    "/teamMembers/{memberId}": {
      "schema": "TeamMember",
      "description": "Team profiles and leadership."
    },
    "/mediaLibrary/{mediaId}": {
      "schema": "MediaItem",
      "description": "Centralized media library assets."
    },
    "/contentRevisions/{revisionId}": {
      "schema": "ContentRevision",
      "description": "Content revision snapshots."
    },
    "/pages/{pageId}": {
      "schema": "CustomPage",
      "description": "Custom editable pages."
    },
    "/siteSettings/{settingId}": {
      "schema": "SiteSettings",
      "description": "Website CMS content, styling, branding, and navigation options."
    },
    "/websiteSettings/{settingId}": {
      "schema": "SiteSettings",
      "description": "Global website settings configuration."
    },
    "/homepageSections/{sectionId}": {
      "schema": "SiteSettings",
      "description": "Homepage section configurations."
    },
    "/seoSettings/{settingId}": {
      "schema": "SiteSettings",
      "description": "Search engine optimization configurations."
    },
    "/inquiries/{inquiryId}": {
      "schema": "Inquiry",
      "description": "Prospective client leads and project requests."
    },
    "/adminUsers/{userId}": {
      "schema": "UserProfile",
      "description": "Administrator account records."
    },
    "/adminData/{dataId}": {
      "schema": "AdminData",
      "description": "Administrative records restricted to the verified owner."
    }
  }
}
