VITE_FIREBASE_API_KEY="AIzaSyD0IwWim2GP7vt_3BjuIXBQg3byfk3ov4U"
VITE_FIREBASE_AUTH_DOMAIN="tesfayeteklu-com.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="tesfayeteklu-com"
VITE_FIREBASE_STORAGE_BUCKET="tesfayeteklu-com.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="414838731101"
VITE_FIREBASE_APP_ID="1:414838731101:web:873d7070908a601445b8b4"
